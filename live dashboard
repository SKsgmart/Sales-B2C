function weightedAvg(arr, qtyKey, avgKey){
  let sumQ=0, sumV=0;
  arr.forEach(r=>{ sumQ += (r[qtyKey]||0); sumV += (r[qtyKey]||0)*(r[avgKey]||0); });
  return sumQ ? sumV/sumQ : 0;
}

