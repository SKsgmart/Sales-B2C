function renderInsights(){
  const feed = DATA.feed;
  if(!feed.length){ document.getElementById('insightsGrid').innerHTML=''; return; }
  const topByTotal = [...feed].sort((a,b)=>b.total-a.total)[0];
  const topByTransit = [...feed].sort((a,b)=>b.transit-a.transit)[0];
  const lowStock = [...feed].sort((a,b)=>a.stock-b.stock)[0];
  const biggestDrop = [...feed].sort((a,b)=>(a.total-a.yesterday)-(b.total-b.yesterday))[0];
  const biggestJump = [...feed].sort((a,b)=>(b.total-b.yesterday)-(a.total-a.yesterday))[0];
  const items = [
    {tag:'info', tagLabel:'Lead location', html:`<b>${topByTotal.location}</b> is leading today at ${fmtTon(topByTotal.total)} t, avg ₹${fmtInt(topByTotal.total_avg)}/ton.`},
    {tag:'watch', tagLabel:'Incoming', html:`<b>${topByTransit.location}</b> has the largest transit pipeline at ${fmtTon(topByTransit.transit)} t.`},
    {tag: lowStock.stock < 3000 ? 'risk':'info', tagLabel:'Stock watch', html:`<b>${lowStock.location}</b> holds the lowest stock at ${fmtTon(lowStock.stock)} t.`},
    {tag:'up', tagLabel:'Day-on-day up', html:`<b>${biggestJump.location}</b> moved from ${fmtTon(biggestJump.yesterday)} t yesterday to ${fmtTon(biggestJump.total)} t today.`},
    {tag:'risk', tagLabel:'Day-on-day down', html:`<b>${biggestDrop.location}</b> is down from ${fmtTon(biggestDrop.yesterday)} t yesterday to ${fmtTon(biggestDrop.total)} t today.`},
  ];
  document.getElementById('insightsGrid').innerHTML = items.map(i=>`
    <div class="ins-item">
      <span class="tag ${i.tag}">${i.tagLabel}</span>
      <p>${i.html}</p>
    </div>`).join('');
}

/* ============ Live polling (same-origin data.json, no CORS issues) ============ */
function setLiveStatus(state, text){
  const dot = document.getElementById('liveDot');
  dot.className = 'dot' + (state==='on'?' on':state==='stale'?' stale':'');
  document.getElementById('liveText').textContent = text;
}

async function fetchLive(){
  try{
    const res = await fetch('./data.json?t=' + Date.now(), {cache:'no-store'});
    if(!res.ok) throw new Error('HTTP '+res.status);
    const json = await res.json();
    DATA = json;
    lastGoodFetch = new Date();
    consecutiveFailures = 0;
    render();
    setLiveStatus('on', 'Live — sheet data as of ' + (json.lastUpdated || lastGoodFetch.toLocaleTimeString('en-IN')));
    document.getElementById('footTime').textContent = json.lastUpdated || lastGoodFetch.toLocaleTimeString('en-IN');
  }catch(err){
    consecutiveFailures++;
    if(lastGoodFetch){
      setLiveStatus('stale', 'Fetch failed — showing data from ' + lastGoodFetch.toLocaleTimeString('en-IN') + ' (' + consecutiveFailures + ' retries)');
    } else {
      setLiveStatus('stale', 'Could not load data.json yet: ' + err.message);
      render(); // fall back to embedded seed so the page isn't blank
    }
  }
}

document.getElementById('footInterval') && (document.getElementById('footInterval').textContent = POLL_SECONDS + 's');
